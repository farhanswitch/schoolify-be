# Application
APP_HOST=0.0.0.0
APP_PORT=8080

# PostgreSQL
DB_HOST2=localhost
DB_PORT2=5432
DB_NAME2=schoolify
DB_USER2=postgres
DB_PASS2=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
# Must be exactly 32 bytes for AES-256 JWE encryption. Replace in every environment.
ENCRYPT_KEY=replace-with-a-32-byte-secret-key
# The current login flow reads SESSION_TIME in seconds.
SESSION_TIME=3600
# The token-refresh middleware reads REFRESH_TIME in minutes.
REFRESH_TIME=5
